# Copy to .env (or let `npm run bootstrap` write it for you).

# Least-privilege app role created by bootstrap. Not the postgres superuser.
DATABASE_URL=postgres://qrprinter:CHANGE_ME@127.0.0.1:5432/qrprinter

# Where the HTTP + websocket server listens.
PORT=8787
HOST=127.0.0.1

# The origin customers and agents reach this server on. The agent refuses a
# document whose host differs from this, so it must match how the agent pairs.
# Local bench: http://127.0.0.1:8787  ·  Production: https://api.your-domain
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Uploaded documents live here, outside any web root. Never served statically.
UPLOAD_DIR=./var/documents

# Session cookie lifetime in days.
SESSION_DAYS=14

# Pairing code lifetime in minutes (single-use, short-lived by design).
PAIRING_CODE_MINUTES=30

# How long a printed document and its file stay visible as "Printed" before the
# sweep removes them. The order keeps the accounting either way.
PRINTED_RETENTION_MINUTES=10

# An order nobody paid for keeps its files this long (counter can still take the
# cash), then its documents and files are purged. The order row stays.
UNPAID_RETENTION_HOURS=24

# A staged upload that no order ever claimed (a request that died mid-upload) is
# deleted once it is this old.
ORPHAN_FILE_MINUTES=60

# Proxy hops to trust for X-Forwarded-For, which rate limits key on.
# 0 in dev. 1 behind Railway's edge. Wrong values let clients spoof their IP.
TRUST_PROXY=0

# --- production only (NODE_ENV=production) ---
# NODE_ENV=production makes the server bind 0.0.0.0, require an https
# PUBLIC_BASE_URL, and refuse to boot without a durable payments key.
# NODE_ENV=production

# 32 bytes as 64 hex chars or base64. Encrypts each shop's Razorpay secrets at
# rest. Without it a random key file is generated in server/var — fine locally,
# fatal on an ephemeral host, where the next deploy loses every shop's keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PAYMENTS_ENC_KEY=

# Platform subscription billing (the Rs 299/mo plan). Optional: without these the
# server runs and shops stay on trial/comp, but nobody can subscribe.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=