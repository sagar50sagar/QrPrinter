<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>QrPrinter.Agent.Tests</RootNamespace>
    <AssemblyName>QrPrinter.Agent.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No PackageReference, and no xunit/NUnit, on purpose. A test suite that
         needs packages downloaded at restore is a suite the shop PC cannot
         reproduce, and the person setting this machine up has no reason to
         trust a test framework any more than they trust the agent binary.
         `dotnet run` here prints one line per check and exits non-zero on the
         first failure count above zero. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\QrPrinter.Agent\QrPrinter.Agent.csproj" />
  </ItemGroup>

</Project>
